adding:0;margin:0;line-height:1}.elementor-widget-heading .elementor-heading-title[class*=elementor-size-]>a{color:inherit;font-size:inherit;line-height:inherit}.elementor-widget-heading .elementor-heading-title.elementor-size-small{font-size:15px}.elementor-widget-heading .elementor-heading-title.elementor-size-medium{font-size:19px}.elementor-widget-heading .elementor-heading-title.elementor-size-large{font-size:29px}.elementor-widget-heading .elementor-heading-title.elementor-size-xl{font-size:39px}.elementor-widget-heading .elementor-heading-title.elementor-size-xxl{font-size:59px}<\/style><h3 class=\"elementor-heading-title elementor-size-default\">Plataforma OMNIA<\/h3>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2a2550a elementor-widget elementor-widget-text-editor\" data-id=\"2a2550a\" data-element_type=\"widget\" data-settings=\"{&quot;ekit_we_effect_on&quot;:&quot;none&quot;}\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"flex-shrink-0 flex flex-col relative items-end\"><div><div class=\"pt-0\"><div class=\"gizmo-bot-avatar flex h-8 w-8 items-center justify-center overflow-hidden rounded-full\"><div class=\"relative p-1 rounded-sm flex items-center justify-center bg-token-main-surface-primary text-token-text-primary h-8 w-8\">O<strong> OMNIA<\/strong> \u00e9 uma plataforma web de desenvolvimento \u00e1gil que conduz a sua empresa \u00e0 verdadeira era da mobilidade digital.<\/div><div>\u00a0<\/div><div class=\"relative p-1 rounded-sm flex items-center justify-center bg-token-main-surface-primary text-token-text-primary h-8 w-8\">Com esta solu\u00e7\u00e3o <em>low-code<\/em>, j\u00e1 n\u00e3o precisa de desenvolver aplica\u00e7\u00f5es de raiz. Pode construir rapidamente aplica\u00e7\u00f5es \u00e0 medida das regras do seu neg\u00f3cio, tornando o desenvolvimento de aplica\u00e7\u00f5es de gest\u00e3o muito mais eficiente.<\/div><div>\u00a0<\/div><div class=\"relative p-1 rounded-sm flex items-center justify-center bg-token-main-surface-primary text-token-text-primary h-8 w-8\">A modela\u00e7\u00e3o \u00e9 r\u00e1pida e flex\u00edvel, contando com um conjunto de Web Components desenhados para proporcionar uma excelente experi\u00eancia de utiliza\u00e7\u00e3o. Definir as regras de neg\u00f3cio que pretende refletir nas suas aplica\u00e7\u00f5es \u00e9 simples e intuitivo.<\/div><div>\u00a0<\/div><div class=\"relative p-1 rounded-sm flex items-center justify-center bg-token-main-surface-primary text-token-text-primary h-8 w-8\">Al\u00e9m disso, a plataforma permite o acesso a Web Apps prontas a usar atrav\u00e9s de qualquer dispositivo com liga\u00e7\u00e3o \u00e0 internet, seja um smartphone, computador ou tablet.<\/div><\/div><\/div><\/div><\/div>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-75ba6e2 e-flex e-con-boxed e-con e-child\" data-id=\"75ba6e2\" data-element_type=\"container\" data-settings=\"{&quot;container_type&quot;:&quot;flex&quot;,&quot;content_width&quot;:&quot;boxed&quot;,&quot;ekit_has_onepagescroll_dot&quot;:&quot;yes&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-346acec elementor-widget elementor-widget-spacer\" data-id=\"346acec\" data-element_type=\"widget\" data-settings=\"{&quot;ekit_we_effect_on&quot;:&quot;none&quot;}\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-314f90e elementor-widget elementor-widget-image\" data-id=\"314f90e\" data-element_type=\"widget\" data-settings=\"{&quot;ekit_we_effect_on&quot;:&quot;none&quot;}\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-w